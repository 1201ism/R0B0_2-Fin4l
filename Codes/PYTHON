def calculate():
    try:
        output_box.delete(1.0, tk.END)

        # Inputs
        a1 = float(entry_a1.get())
        a2 = float(entry_a2.get())
        a3 = float(entry_a3.get())

        T1 = np.radians(float(entry_T1.get()))
        T2 = np.radians(float(entry_T2.get()))
        T3 = np.radians(float(entry_T3.get()))

        # Parametric Table
        PT = [
            [T1, np.radians(270), 0, a1],
            [np.radians(270)+T2, np.radians(180), a2, 0],
            [np.radians(270)+T3, np.radians(0), a3, 0]
        ]

        # HTM Function
        def HTM(theta, alpha, r, d):
            return np.array([
                [np.cos(theta), -np.sin(theta)*np.cos(alpha), np.sin(theta)*np.sin(alpha), r*np.cos(theta)],
                [np.sin(theta), np.cos(theta)*np.cos(alpha), -np.cos(theta)*np.sin(alpha), r*np.sin(theta)],
                [0, np.sin(alpha), np.cos(alpha), d],
                [0, 0, 0, 1]
            ])

        # Transformations
        H0_1 = HTM(*PT[0])
        H1_2 = HTM(*PT[1])
        H2_3 = HTM(*PT[2])

        H0_2 = np.dot(H0_1, H1_2)
        H0_3 = np.dot(H0_2, H2_3)

        # Jacobian
        J1 = np.array([
            [-a2*np.sin(T2)],
            [ a2*np.cos(T2)],
            [0]
        ])

        J2 = np.array([
            [a1*np.cos(T1)],
            [a1*np.sin(T1)],
            [np.sin(T1)*np.sin(T2) + np.cos(T1)*np.cos(T2)]
        ])

        J3 = np.array([
            [0],
            [0],
            [np.sin(T2)*np.sin(T3) + np.cos(T2)*np.cos(T3)]
        ])

        J4 = np.array([[0],[0],[1]])

        J5 = np.array([
            [np.sin(T1)],
            [-np.cos(T1)],
            [0]
        ])

        J6 = np.array([[0],[0],[-1]])

        JM1 = np.concatenate((J1, J2, J3), axis=1)
        JM2 = np.concatenate((J4, J5, J6), axis=1)
        J = np.concatenate((JM1, JM2), axis=0)

        # Determinant
        D_J = np.linalg.det(JM1)

        # Output
        result = ""
        result += "H0_1:\n" + str(np.around(H0_1,3)) + "\n\n"
        result += "H0_2:\n" + str(np.around(H0_2,3)) + "\n\n"
        result += "H0_3:\n" + str(np.around(H0_3,3)) + "\n\n"

        result += "Jacobian Matrix J:\n" + str(np.around(J,3)) + "\n\n"
        result += "Determinant:\n" + str(np.around(D_J,3)) + "\n\n"

        if D_J != 0:
            I_V = np.linalg.inv(JM1)
            result += "Inverse Velocity Matrix:\n" + str(np.around(I_V,3)) + "\n\n"
        else:
            result += "Inverse Velocity Matrix not possible (Singular Matrix)\n\n"

        F_T = np.transpose(JM1)
        result += "Force Torque Matrix:\n" + str(np.around(F_T,3))

        output_box.insert(tk.END, result)

    except Exception as e:
        output_box.insert(tk.END, "Error: " + str(e))


